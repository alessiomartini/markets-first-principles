---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE_TITLE, tracks } from '../lib/site.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Wide pages (glossary, reference shelf) skip the prose measure. */
  wide?: boolean;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Set before first paint so a dark-mode reader never sees a white flash.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
    </script>
  </head>

  <body>
    <header class="masthead">
      <div class="masthead__inner">
        <a class="masthead__title" href={`${base}/`}>{SITE_TITLE}</a>
        <nav class="masthead__nav">
          <a href={`${base}/glossary/`}>Glossary</a>
          <a href={`${base}/notation/`}>Notation</a>
          <a href={`${base}/references/`}>References</a>
          <a href={`${base}/data-sources/`}>Data</a>
          <button class="theme-toggle theme-btn" type="button" data-theme-toggle aria-label="Switch between light and dark">
            theme
          </button>
        </nav>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="footer">
      <div class="shell" style="padding: 0">
        <p>
          {tracks.length} tracks · single author · every figure names its source. Corrections and disagreements are
          welcome — this site is written to be falsifiable.
        </p>
      </div>
    </footer>

    {/*
      The "+ Note" box, injected entirely from its own file so no page template
      carries markup for it. Included here once rather than per page, which is
      this project's equivalent of a script tag before </body> on every page.
    */}
    <script is:inline src={`${base}/js/notes-widget.js`} defer></script>

    <script is:inline>
      // Default follows the system; the button stores an explicit choice and its
      // label names the mode it switches to.
      (() => {
        const root = document.documentElement;
        const sysDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : sysDark());
        const label = () =>
          document.querySelectorAll('.theme-btn').forEach((b) => {
            b.textContent = isDark() ? '☀ Light' : '☾ Dark';
            b.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
          });
        label();
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
        document.querySelectorAll('.theme-btn').forEach((b) =>
          b.addEventListener('click', () => {
            const next = isDark() ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
            label();
          }),
        );
      })();
    </script>
  </body>
</html>
