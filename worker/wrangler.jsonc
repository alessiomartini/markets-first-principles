{
  // Notes collector for markets-first-principles.
  //
  // The only thing this Worker does is accept a POST and write a row to D1.
  // There is deliberately no read endpoint: notes are read straight out of D1
  // (MCP connector, dashboard, or `wrangler d1 execute`), never over HTTP.
  //
  // database_id is filled in at deploy time by
  // .github/workflows/deploy-notes-worker.yml, which looks the database up by
  // name and creates it on first run.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markets-first-principles-notes",
  "main": "src/index.js",
  "compatibility_date": "2025-03-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "markets-first-principles-notes",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ]
}
