{
  // Notes collector for markets-first-principles.
  //
  // The only thing this Worker does is accept a POST and write a row to D1.
  // There is deliberately no read endpoint: notes are read straight out of D1
  // (MCP connector, dashboard, or `wrangler d1 execute`), never over HTTP.
  //
  // The database already exists and its id is committed below, so a local
  // `wrangler deploy` works with no extra steps. The deploy workflow still
  // looks the name up and substitutes the id it finds, which is what makes the
  // whole thing reproducible in a fresh Cloudflare account.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markets-first-principles-notes",
  "main": "src/index.js",
  "compatibility_date": "2025-03-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "markets-first-principles-notes",
      "database_id": "baf64edb-7ba8-49a3-9141-5fc0d8017727"
    }
  ]
}
